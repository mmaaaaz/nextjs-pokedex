{
    "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
    "extends": [
        "ultracite"
    ],
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "ignore": [
            ".next",
            "node_modules",
            "bun.lockb",
            "*.lockb",
            "dist",
            "build",
            ".git"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 2,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "asNeeded",
            "trailingCommas": "es5"
        }
    },
    "json": {
        "formatter": {
            "trailingCommas": "none"
        }
    },
    "organizeImports": {
        "enabled": true
    }
}